{
  "devDependencies": {
    "@tailwindcss/cli": "4.1.18",
    "tailwindcss": "4.1.18"
  },
  "private": true,
  "scripts": {
    "build:css": "tailwindcss -i ./src/styles/input.css -o ./public/assets/css/style.css --minify",
    "watch:css": "tailwindcss -i ./src/styles/input.css -o ./public/assets/css/style.css --watch",
    "build:access": "node scripts/access.mjs",
    "build": "npm run build:css && npm run build:access",
    "preview": "python3 -m http.server 8080 --bind 127.0.0.1 --directory public"
  }
}
